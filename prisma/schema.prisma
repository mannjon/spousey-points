// Spousey Points — full data model (Phase 1).
// Everything is household-scoped: a user can only ever see their own household's data.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Version {
  SPOUSEY
  SILVER
  FAMILY
}

enum OfferStatus {
  PENDING
  ACCEPTED
  DECLINED
  COUNTERED
  CANCELLED
}

enum BountyStatus {
  PENDING_APPROVAL
  OPEN
  CLAIMED
  AWAITING_VERIFY
  COMPLETED
  DECLINED
  EXPIRED
}

enum RewardKind {
  PERSONAL
  SHARED_SOLO
  SHARED_GOAL
}

enum RewardAudience {
  SELF
  PLUS_ONE
  FAMILY
}

enum RewardStatus {
  ACTIVE
  OPEN
  COMPLETED
  FAILED
}

enum RewardRequestStatus {
  PENDING
  APPROVED
  DECLINED
  FINALIZED
}

model Household {
  id        String   @id @default(cuid())
  name      String?
  createdAt DateTime @default(now())

  users          User[]
  children       Child[]
  offers         Offer[]
  bounties       Bounty[]
  logEntries     LogEntry[]
  notices        Notice[]
  pendingInvites PendingInvite[]
  rewards        Reward[]
  rewardRequests RewardRequest[]
  rewardTiers    RewardTier[]
  specialOffers  SpecialOffer[]
  coupons        Coupon[]
}

model User {
  id                  String   @id @default(cuid())
  householdId         String
  household           Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  screenName          String   @unique
  passwordHash        String
  version             Version  @default(SPOUSEY)
  points              Int      @default(100)
  tokens              Int      @default(0)
  weeklyDowntimeHours Int      @default(20)
  invitePromptDone    Boolean  @default(false)
  rewardsSeeded       Boolean  @default(false)
  // Lazy weekly-engine marker: Saturday point grants + month-end expiry are
  // applied for every boundary after this instant, then it advances to now.
  pointsMarkerAt      DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  offersSent       Offer[]     @relation("OfferFrom")
  offersReceived   Offer[]     @relation("OfferTo")
  bountiesPosted   Bounty[]    @relation("BountyPostedBy")
  bountiesApproved Bounty[]    @relation("BountyApprovedBy")
  bountiesClaimed  Bounty[]    @relation("BountyClaimedBy")
  bountySeen       BountySeen[]
  kidApprovals     BountyKidApproval[]
  logEntries       LogEntry[]  @relation("LogActor")
  notices          Notice[]

  rewardsOwned     Reward[]    @relation("RewardOwnerUser")
  rewardsCreated   Reward[]    @relation("RewardCreatedBy")
  rewardsLocked    Reward[]    @relation("RewardLockedBy")
  rewardRequests   RewardRequest[] @relation("RequestBy")
  rewardParts      RewardPart[]    @relation("PartMemberUser")
  contributionsFrom RewardContribution[] @relation("ContributionFromUser")
  contributionsFor  RewardContribution[] @relation("ContributionForUser")
  rewardTiers      RewardTier[]    @relation("TierOwner")
  specialOffers    SpecialOffer[]  @relation("SpecialOwner")
  coupons          Coupon[]        @relation("CouponOwner")

  @@index([householdId])
}

model Child {
  id                     String    @id @default(cuid())
  householdId            String
  household              Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  name                   String
  tokens                 Int       @default(0)
  weeklyAllowanceDollars Float     @default(5)
  weeklyTokenAmount      Int       @default(100)
  // Lazy weekly-engine marker for the Saturday token drop.
  dropMarkerAt           DateTime?
  rewardsSeeded          Boolean   @default(false)
  createdAt              DateTime  @default(now())

  kidClaims Bounty[] @relation("BountyKidClaim")

  rewardsOwned     Reward[]    @relation("RewardOwnerChild")
  rewardParts      RewardPart[]    @relation("PartMemberChild")
  contributionsFrom RewardContribution[] @relation("ContributionFromChild")
  contributionsFor  RewardContribution[] @relation("ContributionForChild")

  @@index([householdId])
}

// A point offer from one user to another. On acceptance the amount is
// deducted from the sender's points and lands in the receiver's tokens 1:1.
model Offer {
  id           String      @id @default(cuid())
  householdId  String
  household    Household   @relation(fields: [householdId], references: [id], onDelete: Cascade)
  fromUserId   String
  fromUser     User        @relation("OfferFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId     String
  toUser       User        @relation("OfferTo", fields: [toUserId], references: [id], onDelete: Cascade)
  amount       Int
  reason       String?
  status       OfferStatus @default(PENDING)
  counterAmount Int?
  createdAt    DateTime    @default(now())
  resolvedAt   DateTime?

  @@index([householdId])
  @@index([toUserId, status])
}

// A bounty is NOT a transfer: completing an approved bounty EARNS tokens.
// Nobody's balance is ever debited for a bounty.
model Bounty {
  id          String       @id @default(cuid())
  householdId String
  household   Household    @relation(fields: [householdId], references: [id], onDelete: Cascade)
  title       String
  details     String?
  value       Int
  dueDate     DateTime?
  status      BountyStatus @default(PENDING_APPROVAL)

  postedById String
  postedBy   User   @relation("BountyPostedBy", fields: [postedById], references: [id], onDelete: Cascade)

  approvedById String?
  approvedBy   User?   @relation("BountyApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  claimedById String?
  claimedBy   User?   @relation("BountyClaimedBy", fields: [claimedById], references: [id], onDelete: SetNull)

  // Kid claims: a child claims instead of a user. Both parents must approve
  // the claim (BountyKidApproval rows) before the child can take the bounty,
  // and the poster approves the finished work (workVerifiedById).
  kidClaimChildId String?
  kidClaimChild   Child?  @relation("BountyKidClaim", fields: [kidClaimChildId], references: [id], onDelete: SetNull)

  workVerifiedById String?
  completedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  seen        BountySeen[]
  kidApprovals BountyKidApproval[]

  @@index([householdId, status])
}

// Per-user "has viewed this bounty" flag (drives the NEW! flagging on the board).
model BountySeen {
  id       String   @id @default(cuid())
  bountyId String
  bounty   Bounty   @relation(fields: [bountyId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  seenAt   DateTime @default(now())

  @@unique([bountyId, userId])
}

// One row per parent approval of a kid's bounty claim; two distinct parents
// approving = the kid may take the bounty.
model BountyKidApproval {
  id        String   @id @default(cuid())
  bountyId  String
  bounty    Bounty   @relation(fields: [bountyId], references: [id], onDelete: Cascade)
  parentId  String
  parent    User     @relation(fields: [parentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([bountyId, parentId])
}

// Fact-only log lines. `text` states the fact; `kind` is a machine tag
// (e.g. OFFER_ACCEPTED, BOUNTY_EARNED, CHILD_CREDIT, CHILD_DEDUCT, REDEEM,
// BUY_POINTS, WEEKLY_DROP, LOVE_TAP).
model LogEntry {
  id          String    @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  actorId     String?
  actor       User?     @relation("LogActor", fields: [actorId], references: [id], onDelete: SetNull)
  subjectUserId String?
  childId       String?
  kind        String
  text        String
  amount      Int?
  note        String?
  counteredFrom Int?
  createdAt   DateTime  @default(now())

  @@index([householdId, createdAt])
}

model Notice {
  id          String    @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind        String
  text        String
  fromUserId  String?
  amount      Int?
  logEntryId  String?
  accepted    Boolean   @default(false)
  createdAt   DateTime  @default(now())

  @@index([userId, accepted])
}

// Per-user "has viewed this log entry" flag. An entry that changed things
// indirectly for a user (someone else's action, or a system event) carries a
// dot for that user until a LogSeen row exists.
model LogSeen {
  id         String   @id @default(cuid())
  logEntryId String
  userId     String
  seenAt     DateTime @default(now())

  @@unique([logEntryId, userId])
  @@index([userId])
}

// A person invited at a user's first login, recorded by screen name before
// they have signed up. Requests can be addressed to them; no tokens are
// ever sent to or held for a pending invite (tokens never transfer).
model PendingInvite {
  id          String    @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  invitedById String
  screenName  String
  createdAt   DateTime  @default(now())

  @@index([householdId])
}

// ------------------------------------------------------------------ rewards
// A reward line owned by one person (an adult user or a child). Cashing in
// is NEVER a transfer: only the person cashing in has their balance
// decreased, and only at the final tap. A kid's cash-in just sends a
// notification — no approval, no balance change.
model Reward {
  id          String         @id @default(cuid())
  householdId String
  household   Household      @relation(fields: [householdId], references: [id], onDelete: Cascade)

  ownerUserId  String?
  ownerUser    User?   @relation("RewardOwnerUser", fields: [ownerUserId], references: [id], onDelete: Cascade)
  ownerChildId String?
  ownerChild   Child?  @relation("RewardOwnerChild", fields: [ownerChildId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User    @relation("RewardCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  title       String
  description String?
  cost        Int
  kind        RewardKind     @default(PERSONAL)
  audience    RewardAudience @default(SELF)
  isDefault   Boolean        @default(false)
  saved       Boolean        @default(false)
  freeRedeem  Boolean        @default(false)
  status      RewardStatus   @default(ACTIVE)
  dueDate     DateTime?

  locked     Boolean @default(false)
  lockedById String?
  lockedBy   User?   @relation("RewardLockedBy", fields: [lockedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parts         RewardPart[]
  contributions RewardContribution[]
  requests      RewardRequest[]

  @@index([householdId])
}

// One member's expected share of a shared-goal reward. Parts default to an
// even split of the total; members can change their own part, and anyone
// can put in extra past their part so the group does not fail.
model RewardPart {
  id       String @id @default(cuid())
  rewardId String
  reward   Reward @relation(fields: [rewardId], references: [id], onDelete: Cascade)

  memberUserId  String?
  memberUser    User?   @relation("PartMemberUser", fields: [memberUserId], references: [id], onDelete: Cascade)
  memberChildId String?
  memberChild   Child?  @relation("PartMemberChild", fields: [memberChildId], references: [id], onDelete: Cascade)

  amount Int

  @@unique([rewardId, memberUserId])
  @@unique([rewardId, memberChildId])
  @@index([rewardId])
}

// Tokens actually put toward a shared goal. The bank debited is the part
// member's own bank (part contributions) or the contributor's own bank
// (extra contributions, part ids null). Refunded in full if the goal
// fails by its due date.
model RewardContribution {
  id       String @id @default(cuid())
  rewardId String
  reward   Reward @relation(fields: [rewardId], references: [id], onDelete: Cascade)

  fromUserId  String?
  fromUser    User?   @relation("ContributionFromUser", fields: [fromUserId], references: [id], onDelete: Cascade)
  fromChildId String?
  fromChild   Child?  @relation("ContributionFromChild", fields: [fromChildId], references: [id], onDelete: Cascade)

  partUserId  String?
  partUser    User?   @relation("ContributionForUser", fields: [partUserId], references: [id], onDelete: SetNull)
  partChildId String?
  partChild   Child?  @relation("ContributionForChild", fields: [partChildId], references: [id], onDelete: SetNull)

  amount    Int
  createdAt DateTime @default(now())

  @@index([rewardId])
}

// An adult's cash-in request: the other adult approves or declines, then
// the requester finalizes with a tap — that tap is the only moment any
// balance changes.
model RewardRequest {
  id          String              @id @default(cuid())
  householdId String
  household   Household           @relation(fields: [householdId], references: [id], onDelete: Cascade)
  rewardId    String
  reward      Reward              @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  requesterId String
  requester   User                @relation("RequestBy", fields: [requesterId], references: [id], onDelete: Cascade)
  status      RewardRequestStatus @default(PENDING)
  createdAt   DateTime            @default(now())
  resolvedAt  DateTime?

  @@index([householdId, status])
  @@index([requesterId, status])
}

enum SpecialEffect {
  POINTS
  TOKENS
  BUNDLE
}

enum SpecialStatus {
  AVAILABLE
  PENDING
  CONSUMED
}

// One-time offers in the permanent Special Offers category. Redeem only
// notifies the other adults; their in-person tap consumes the offer and
// applies its effect.
model SpecialOffer {
  id          String        @id @default(cuid())
  householdId String
  household   Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  ownerUserId String
  owner       User          @relation("SpecialOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  title       String
  effect      SpecialEffect
  amount      Int?
  bundle      Json?
  status      SpecialStatus @default(AVAILABLE)
  createdAt   DateTime      @default(now())
  resolvedAt  DateTime?

  @@index([householdId, ownerUserId, status])
}

enum CouponStatus {
  AVAILABLE
  USED
}

// A single usable coupon, granted by an approved gift pack (a BUNDLE
// special offer). Coupons stay grouped under their pack's name.
model Coupon {
  id          String       @id @default(cuid())
  householdId String
  household   Household    @relation(fields: [householdId], references: [id], onDelete: Cascade)
  ownerUserId String
  owner       User         @relation("CouponOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  title       String
  packName    String
  status      CouponStatus @default(AVAILABLE)
  createdAt   DateTime     @default(now())
  usedAt      DateTime?

  @@index([householdId, ownerUserId, status])
}

// Cost-range groups for a user's reward list. Seeded with the default
// ranges; users can delete them and create their own.
model RewardTier {
  id          String    @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation("TierOwner", fields: [userId], references: [id], onDelete: Cascade)
  minCost     Int
  maxCost     Int?
  createdAt   DateTime  @default(now())

  @@index([userId])
}
